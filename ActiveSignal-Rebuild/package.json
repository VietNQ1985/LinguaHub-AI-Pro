{
  "name": "signaldesk-rebuild",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone local workspace prototype.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "desktop": "electron electron/main.cjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.signaldesk.workspace",
    "productName": "SignalDesk",
    "electronVersion": "45.2.1",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SignalDesk",
      "uninstallDisplayName": "SignalDesk"
    }
  }
}
